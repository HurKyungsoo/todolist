# 루트 docker-compose.yml 배포용 환경변수. 실제 값으로 채운 뒤 .env 로 복사:
#   cp .env.example .env

# --- DB (mysql / app 공용) ---
DB_NAME=todolist
DB_USERNAME=todouser
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- 백엔드 ---
# JWT 서명 키. 최소 32바이트(영문/숫자 32자 이상). 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long

# CORS 허용 오리진. 프론트를 nginx(web) 뒤 같은 오리진으로 서빙하면 기본값으로 충분.
# 다른 도메인에서 API 를 직접 호출할 때만 추가 (콤마 구분).
CORS_ALLOWED_ORIGINS=http://localhost
